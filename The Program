//Function for determining the speed at which the wheels are moving version a (two buckets approach)
float wheel_speed_a(volatile unsigned long &pulse_time, volatile unsigned long &pulse_interval, volatile unsigned long &last_pulse_time, volatile unsigned long &last_speed_check) {
  noInterrupts();
  unsigned long count snapshot = pulse_count;
  unsigned long interval_snapshot = pulse_interval;
  unsigned long last_time_snapshot = last_pulse_time;
  interrupts();

  unsigned long time_since_last_pulse = micros() - last_time_snapshot;

  //more than one pulse since last speed check, is fine
  if (count_snapshot >= 2) {
    return (count_snapshot * mm_per_tick)/(last_speed_check/1e6f);
  }

  if (count_snapshot == 1 && interval_snapshot > 0) {
    return (mm_per_tick)/(interval_snapshot/ 1e6f);
  }

  if (time_since_last_pulse > STOPPED_THRESHOLD){
    return 0.0f;
  }
  
  return NaN;
}

//Same as above but version b (one bucket approach)
float wheel_speed_b(volatile unsigned long &pulse_time, volatile unsigned long &pulse_interval, volatile unsigned long &last_pulse_time) {
  noInterrupts();
  unsigned long count snapshot = pulse_count;
  unsigned long interval_snapshot = pulse_interval;
  unsigned long last_time_snapshot = last_pulse_time;
  interrupts();

  unsigned long time_since_last_pulse = micros() - last_time_snapshot;

  if (count_snapshot == 0){
    if (time_since_last_pulse > STOPPED_THRESHOLD){
      return 0.0f;
    }
    return NaN;
  }
  return (mm_per_tick / (interval_snapshot / 1e6f));
}


