void dead_reckoning(State state, float distance){
  if (state == StateTurn){
    return;
  }
  else if (mouse_direction == NORTH){
    mouse_y += distance;
  }
  else if (mouse_direction == EAST){
    mouse_x += distance;
  }
  else if (mouse_direction == SOUTH){
    mouse_y -= distance;
  }
  else if (mouse_direction == WEST){
    mouse_x -= distance;
  }
}

